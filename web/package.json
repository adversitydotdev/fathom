{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "OPENGRC_API_MOCKING=enabled next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:api": "openapi-typescript ../api/openapi.yaml --default-non-nullable false -o src/lib/api/schema.d.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "drive": "node e2e/drive.mjs",
    "e2e:serve": "NEXT_DIST_DIR=.next-e2e OPENGRC_API_MOCKING=enabled sh -c 'next build && next start --port ${E2E_PORT:-3200}'",
    "compare": "node e2e/compare.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "motion": "^14.11.1",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "msw": "^3.0.4",
    "openapi-typescript": "^7.13.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0"
}
